<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="paperformat_commercial_invoice_olefins" model="report.paperformat">
        <field name="name">Custom Commercial Invoice A4</field>
        <field name="default" eval="True"/>
        <field name="format">A4</field>
        <field name="page_height">0</field>
        <field name="page_width">0</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">25</field>
        <field name="margin_bottom">15</field>
        <field name="margin_left">10</field>
        <field name="margin_right">10</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">15</field>
        <field name="dpi">90</field>
    </record>

    <record id="action_report_commercial_invoice_olefins" model="ir.actions.report">
        <field name="name">Commercial Invoice Olefins</field>
        <field name="model">account.move</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">commercial_invoice_olefins.report_commercial_invoice_olefins</field>
        <field name="report_file">commercial_invoice_olefins.report_commercial_invoice_olefins</field>
        <field name="print_report_name">'Commercial_Invoice_Olefins_%s' % (object.name or 'Draft')</field>
        <field name="binding_model_id" ref="account.model_account_move"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="commercial_invoice_olefins.paperformat_commercial_invoice_olefins"/>
    </record>
</odoo>

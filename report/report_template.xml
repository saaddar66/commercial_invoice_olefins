<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_commercial_invoice_olefins_document">
        <t t-call="web.basic_layout">

            <!-- ═══════════════════════════════════════════════════
                 PAGE-LEVEL CSS
                 ═══════════════════════════════════════════════════ -->
            <style>
                @page {
                    margin-top: 1.5cm;
                    margin-bottom: 32mm;
                    margin-left: 1.0cm;
                    margin-right: 1.0cm;
                }
                /* Fixed footer printed on every page */
                .inv-page-footer {
                    position: fixed !important;
                    bottom: 0;
                    left: 0;
                    right: 0;
                    width: 100%;
                    font-family: Arial, sans-serif;
                    font-size: 7pt;
                    border-top: 1px solid #888;
                    padding-top: 2px;
                    background: white;
                }
                body, .inv-body {
                    padding-bottom: 60px;
                }
                .inv-page-footer table {
                    width: 100%;
                    border: none;
                }
                .inv-page-footer td {
                    border: none;
                    padding: 0 4px;
                }
                /* Main page body */
                .inv-body {
                    font-family: Arial, sans-serif;
                    font-size: 10pt;
                    background-color: white;
                    padding-bottom: 90mm;
                }
                /* Table */
                .inv-table {
                    border-collapse: collapse;
                    width: 100%;
                    font-size: 9pt;
                    page-break-inside: auto;
                }
                .inv-table tr {
                    page-break-inside: avoid !important;
                }
                .inv-table th,
                .inv-table td {
                    border: 1px solid black !important;
                    padding: 3px 5px !important;
                }
                .inv-table thead {
                    background-color: #d3d3d3 !important;
                    display: table-header-group !important;
                }
                .inv-table thead th {
                    border-bottom: 2px solid black !important;
                }
                .text-right { text-align: right; }
                .text-center { text-align: center; }
            </style>

            <div class="inv-body">

                <!-- ─── TITLE ──────────────────────────────────────── -->
                <div class="text-center" style="margin-bottom: 16px;">
                    <h2 style="font-size: 14pt; font-weight: bold; margin: 0;">Olefins (Private) Limited</h2>
                    <h2 style="font-size: 14pt; font-weight: bold; margin: 0;">COMMERCIAL INVOICE</h2>
                </div>

                <!-- ─── INFO ROW: Invoice / Delivery Order / Sale Order / PO / Payment ── -->
                <div class="row" style="margin-bottom: 14px;">
                    <!-- Invoice NO / Date -->
                    <div class="col">
                        <strong>Invoice NO/Date:</strong><br/>
                        <span t-field="o.name"/> /
                        <span t-esc="o.invoice_date and o.invoice_date.strftime('%d-%b-%Y') or ''"/>
                    </div>

                    <!-- Delivery Order NO / Date -->
                    <div class="col">
                        <t t-set="delivery_orders"
                           t-value="o.invoice_line_ids.mapped('sale_line_ids').mapped('order_id').mapped('picking_ids').filtered(lambda p: p.state != 'cancel')"/>
                        <t t-set="do_names"
                           t-value="', '.join(delivery_orders.mapped('name')) if delivery_orders else ''"/>
                        <t t-set="do_dates"
                           t-value="', '.join([(p.date_done or p.scheduled_date).strftime('%d-%b-%Y') for p in delivery_orders if (p.date_done or p.scheduled_date)]) if delivery_orders else ''"/>
                        <strong>Delivery Order NO/Date:</strong><br/>
                        <span t-esc="do_names"/> /
                        <span t-esc="do_dates"/>
                    </div>

                    <!-- Sale Order NO / Date -->
                    <div class="col">
                        <t t-set="sale_orders"
                           t-value="o.invoice_line_ids.mapped('sale_line_ids').mapped('order_id')"/>
                        <t t-set="so_names"
                           t-value="', '.join(sale_orders.mapped('name')) if sale_orders else ''"/>
                        <t t-set="so_dates"
                           t-value="', '.join([s.date_order.strftime('%d-%b-%Y') for s in sale_orders if s.date_order]) if sale_orders else ''"/>
                        <strong>Sale Order NO/Date:</strong><br/>
                        <span t-esc="so_names"/> /
                        <span t-esc="so_dates"/>
                    </div>

                    <!-- PO No/Date -->
                    <div class="col">
                        <t t-set="po_refs" t-value="', '.join(filter(bool, sale_orders.mapped('client_order_ref'))) if sale_orders and any(sale_orders.mapped('client_order_ref')) else o.ref"/>
                        <strong>PO No/Date:</strong><br/>
                        <span t-esc="po_refs"/> /
                        <span t-esc="so_dates"/>
                    </div>

                </div>

                <!-- ─── ADDRESSES (Bill To / Ship To) ──────────────── -->
                <div class="row" style="margin-bottom: 14px;">
                    <div class="col-6">
                        <strong>Bill To:</strong>
                        <span t-field="o.partner_id.id"/> /
                        <span t-field="o.partner_id.name"/><br/>
                        <strong>Address:</strong>
                        <span t-field="o.partner_id.street"/>, 
                        <span t-field="o.partner_id.city"/> -
                        <span t-field="o.partner_id.state_id.name"/>,
                        <span t-field="o.partner_id.country_id.name"/><br/>
                        <strong>Cell:</strong>
                        <span t-field="o.partner_id.phone"/><br/>
                        <strong>NIC:</strong><br/>
                        <strong>NTN:</strong> <span t-field="o.partner_id.vat"/><br/>
                        <strong>STRN:</strong> 
                        <t t-if="'x_studio_strn' in o.partner_id._fields">
                            <span t-esc="o.partner_id.x_studio_strn"/>
                        </t>
                        <t t-elif="'x_strn' in o.partner_id._fields">
                            <span t-esc="o.partner_id.x_strn"/>
                        </t>
                        <t t-elif="'strn' in o.partner_id._fields">
                            <span t-esc="o.partner_id.strn"/>
                        </t>
                        <t t-else="">
                            <span t-esc="o.partner_id.vat"/>
                        </t>
                    </div>
                    <div class="col-6">
                        <t t-set="shipping" t-value="o.partner_shipping_id or o.partner_id"/>
                        <strong>Ship To:</strong>
                        <span t-esc="shipping.id"/> /
                        <span t-esc="shipping.name"/><br/>
                        <strong>Address:</strong>
                        <span t-esc="shipping.street"/>, 
                        <span t-esc="shipping.city"/> -
                        <span t-esc="shipping.state_id.name"/>,
                        <span t-esc="shipping.country_id.name"/><br/>
                        <strong>Cell:</strong>
                        <span t-esc="shipping.phone"/><br/>
                    </div>
                </div>

                <!-- ─── LINE ITEMS TABLE ────────────────────────────── -->
                <t t-set="total_qty" t-value="0.0"/>
                <t t-set="total_val_excl" t-value="0.0"/>
                <t t-set="total_sales_tax" t-value="0.0"/>
                <t t-set="total_further_tax" t-value="0.0"/>
                <t t-set="total_val_incl" t-value="0.0"/>

                <table class="inv-table">
                    <thead>
                        <tr>
                            <th style="width:22%;">Description</th>
                            <th class="text-right" style="width:7%;">Quantity</th>
                            <th style="width:5%;">UoM</th>
                            <th class="text-right" style="width:9%;">Unit Price</th>
                            <th class="text-right" style="width:5%;">Additional Disc</th>
                            <th class="text-right" style="width:8%;">Unit Price after Disc</th>
                            <th class="text-right" style="width:8%;">Value Excluding Sales Tax</th>
                            <th class="text-right" style="width:8%;">Sales tax 18%</th>
                            <th class="text-right" style="width:9%;">Further Tax 4%</th>
                            <th class="text-right" style="width:9%;">Value Including Sales Tax</th>
                        </tr>
                    </thead>
                    <tbody>
                        <!-- Only product lines (no section/note rows) -->
                        <t t-foreach="o.invoice_line_ids.filtered(lambda l: l.display_type not in ('line_section', 'line_note'))" t-as="line">

                            <!-- Per-line calculations -->
                            <t t-set="trade_disc"
                               t-value="line.price_unit * (line.discount / 100.0) if line.discount else 0.0"/>
                            <t t-set="unit_after_disc"
                               t-value="line.price_unit * (1.0 - line.discount / 100.0) if line.discount else line.price_unit"/>
                            <t t-set="sales_tax" t-value="line.price_total - line.price_subtotal"/>
                            <t t-set="further_tax" t-value="0.00"/>

                            <!-- Accumulate totals -->
                            <t t-set="total_qty" t-value="total_qty + line.quantity"/>
                            <t t-set="total_val_excl" t-value="total_val_excl + line.price_subtotal"/>
                            <t t-set="total_sales_tax" t-value="total_sales_tax + sales_tax"/>
                            <t t-set="total_further_tax" t-value="total_further_tax + further_tax"/>
                            <t t-set="total_val_incl" t-value="total_val_incl + line.price_total"/>

                            <tr>
                                <td>
                                    <t t-if="line.product_id.default_code">
                                        <span t-esc="line.product_id.default_code"/>/<span t-esc="line.product_id.name"/>
                                    </t>
                                    <t t-else="">
                                        <span t-esc="line.product_id.name or line.name or ''"/>
                                    </t>
                                </td>
                                <td class="text-right">
                                    <span t-esc="'{:.3f}'.format(line.quantity)"/>
                                </td>
                                <td>
                                    <span t-esc="line.product_uom_id.name if line.product_uom_id else ''"/>
                                </td>
                                <td class="text-right">
                                    <span t-esc="'{:.4f}'.format(line.price_unit)"/>
                                </td>
                                <td class="text-right">
                                    <span t-esc="'{:.4f}'.format(trade_disc)"/>
                                </td>
                                <td class="text-right">
                                    <span t-esc="'{:.4f}'.format(unit_after_disc)"/>
                                </td>
                                <td class="text-right">
                                    <span t-esc="'{:,.2f}'.format(line.price_subtotal)"/>
                                </td>
                                <td class="text-right">
                                    <span t-esc="'{:,.2f}'.format(sales_tax)"/>
                                </td>
                                <td class="text-right">
                                    <span t-esc="'{:,.2f}'.format(further_tax)"/>
                                </td>
                                <td class="text-right">
                                    <span t-esc="'{:,.2f}'.format(line.price_total)"/>
                                </td>
                            </tr>
                        </t>
                        <!-- FORCE SEPARATOR -->
                        <tr>
                            <td colspan="10" style="border: none; height: 10px;"></td>
                        </tr>
                        <!-- ── TOTAL ROW ── -->
                        <tr>
                            <td>
                                <strong>Total</strong>
                            </td>
                            <td class="text-right">
                                <strong>
                                    <span t-esc="'{:.3f}'.format(total_qty)"/>
                                </strong>
                            </td>
                            <td colspan="4"></td>
                            <td class="text-right">
                                <strong><span t-esc="'{:,.2f}'.format(total_val_excl)"/></strong>
                            </td>
                            <td class="text-right">
                                <strong><span t-esc="'{:,.2f}'.format(total_sales_tax)"/></strong>
                            </td>
                            <td class="text-right">
                                <strong><span t-esc="'{:,.2f}'.format(total_further_tax)"/></strong>
                            </td>
                            <td class="text-right">
                                <strong><span t-esc="'{:,.2f}'.format(total_val_incl)"/></strong>
                            </td>
                        </tr>

                        <!-- ── ADDITIONAL DISCOUNTS & FREIGHT ── -->
                        <tr>
                            <td colspan="9">
                                <strong>Fixed Discount</strong>
                            </td>
                            <td class="text-right">
                                <strong>0.00</strong>
                            </td>
                        </tr>
                        <tr>
                            <td colspan="9">
                                <strong>Percentage Discount</strong>
                            </td>
                            <td class="text-right">
                                <strong>0.00</strong>
                            </td>
                        </tr>
                        <tr>
                            <td colspan="9">
                                <strong>Freight</strong>
                            </td>
                            <td class="text-right">
                                <strong>0.00</strong>
                            </td>
                        </tr>

                        <!-- ── GRAND TOTAL ── -->
                        <tr>
                            <td colspan="9">
                                <strong>Grand Total:</strong>
                            </td>
                            <td class="text-right">
                                <strong><span t-esc="'{:,.2f}'.format(o.amount_total)"/></strong>
                            </td>
                        </tr>

                        <!-- ── AMOUNT IN WORDS (Pakistani format) ── -->
                        <tr>
                            <td colspan="10">
                                <strong>Amount in Words: </strong>
                                <span t-esc="o.amount_total_words_pkr"/>
                            </td>
                        </tr>

                        <!-- ── REMARKS ── -->
                        <tr>
                            <td colspan="10" style="height: 50px;">
                                <strong>Remarks:</strong>
                            </td>
                        </tr>
                    </tbody>
                </table>

            </div>
        </t>
    </template>

    <!-- ═══════════════════════════════════════════════════════════════
         OUTER WRAPPER — iterates docs, injects fixed footer per page
         ═══════════════════════════════════════════════════════════════ -->
    <template id="report_commercial_invoice_olefins">
        <t t-call="web.html_container">
            <div class="footer" style="width:100%; font-family: DejaVu Sans, Liberation Sans, sans-serif; font-size: 10px;padding-bottom:10px;">
                
                <div class="text-center" style="padding-bottom:0px;">
                    "This is a system generated Invoice and does not require any signature"<br/>
                    Plot No: H 23/3 Shed No 7, Landhi Industrial Area, Bin Qasim Town, Karachi<br/>
                    NTN: 8240930-8, Tel: 9221-35130303, olefins_sales@anabatla.com
                </div>

                <div style="white-space: nowrap; display: flex; justify-content: space-between; font-size: 9px; margin-top: 8px; border-top: 1px solid #bbb; padding-top: 4px; padding-bottom: 6px;">
                    <span>
                        User ID: <span t-esc="env.user.login"/>
                    </span>
                    <span>
                        Date: <span t-esc="context_timestamp(datetime.datetime.now()).strftime('%d-%b-%Y')"/>
                    </span>
                    <span>
                        Time: <span t-esc="context_timestamp(datetime.datetime.now()).strftime('%H:%M:%S')"/>
                    </span>
                    <span>
                        Page <span class="page"/> of <span class="topage"/>
                    </span>
                </div>

            </div>

            <t t-foreach="docs" t-as="o">
                <!-- Invoice body -->
                <t t-call="commercial_invoice_olefins.report_commercial_invoice_olefins_document"/>
            </t>
        </t>
    </template>
</odoo>
